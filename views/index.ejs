<!--This file is for that data where client can see or you can say main client site where client can see-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Mini Whatsapp</title>
    <link rel = "stylesheet" href="/style.css"/> <!--linking css file -->
</head>
<body>
    <h3>All Chats!</h3>
    <form method="GET" action="/chats/new"> <!--when new chat get clicked it will go to this routh-->
        <button>New Chat</button> <!--Here when new chat button has clicked then a from render -->
    </form>
    <br/>

    <% for(let chat of chats){%> <!--This is for individual chat-->
    <div class="chat">
        <p>From : <%= chat.from %> </p>
        <div class="msg">
             <p> <%= chat.msg %> </p>
             <form method="GET" action="/chats/<%=chat.id%>/edit"> <!--res goes to this path after clicking edit-->
                <button>edit</button> <!--edit button inside msg-->
             </form>
             <br/>
             <form method="POST" action="/chats/<%=chat.id%>?_method=DELETE"> <!--Here req goes as as a delete method way...but here we just name as a post but actually it's DELETE -->
                <button>Delete</button> 
             </form>
        </div>
        <p>Recived by <%= chat.to %> </p>
        <hr/> <!--For each div-->
        <p><%= chat.created_at.toString().split(" ") [4] %> </p>  <!--so created_at is our date & this is for our date only (00:04:56)-->
        <p><%= chat.created_at.toString().split(" ").slice(0 , 4).join("-") %> </p> <!--join in - like (sun-sep-17-2023)  -->
    </div>
    <br/><br/>
<%}%>

</body>
</html>

